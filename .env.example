# Copy this file to `.env` and adjust the values. Never commit `.env`.

# PostgreSQL connection string (docker-compose.yml starts a matching database).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"

# Secret used to sign session tokens. REQUIRED — replace with a long random
# string, e.g. the output of: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Session lifetime (jsonwebtoken format, e.g. 8h, 1d).
JWT_EXPIRES_IN="8h"

# self-hosted (default): exactly one organization, login with username or email.
# saas: many organizations, login with email or organization code + username.
APP_MODE="self-hosted"

# `npx prisma db seed` WIPES the whole database. It refuses to run when
# NODE_ENV=production unless this is set to "true" on purpose.
# ALLOW_DESTRUCTIVE_SEED="false"

# Pengaturan OPSIONAL untuk kontainer Docker. Salin menjadi docker/.env lalu
# ubah seperlunya — tanpa berkas ini semua nilai bawaan di bawah dipakai.
# Berkas .env di root proyek TIDAK dibaca oleh docker/compose.*.yml.

# ── Mode pengembangan (docker-dev.bat / docker/compose.dev.yml) ─────────────
DEV_PORT=3000
# PostgreSQL dev dibuka di 127.0.0.1:<port> (user postgres, password postgres,
# database inventory). Bawaan 55432 agar tidak bentrok dengan PostgreSQL lain (5432, 5433, ...).
DEV_DB_PORT=55432
# `saas` dibutuhkan QA runner (`npm run qa`). Setelah mengganti, isi ulang data:
#   docker-dev.bat seed
DEV_APP_MODE=self-hosted
# Interval polling perubahan file (ms). Set 0 di Linux (inotify sudah berjalan).
WATCH_POLL_INTERVAL_MS=2000

# ── Mode produksi (docker-prod.bat / docker/compose.prod.yml) ───────────────
PROD_PORT=8000
PROD_APP_MODE=self-hosted

# Organisasi & Super Admin yang dibuat pada start PERTAMA (database kosong).
# Mengubahnya setelah itu tidak berpengaruh — kelola lewat antarmuka.
ORG_NAME="Organisasi Saya"
# Kode organisasi (login mode saas): ^[a-z0-9-]{3,32}$
ORG_SLUG=main
ADMIN_NAME="Super Administrator"
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@inventory.local
# Kosongkan agar dibuat acak (dicetak sekali di log kontainer). Minimal 8 karakter.
ADMIN_PASSWORD=

# ── Akses publik lewat Cloudflare Tunnel (produksi, tanpa VPS) ──────────────
# Domain sendiri: buat tunnel di Cloudflare Zero Trust ➡️ Networks ➡️ Tunnels,
# Public Hostname ➡️ Service HTTP `localhost:3000`, lalu tempel tokennya di sini.
# Rahasia — jangan dibagikan. Lihat docs/docker.md.
CLOUDFLARE_TUNNEL_TOKEN=
# Alamat acak *.trycloudflare.com tanpa akun (berganti setiap restart). Cukup
# jalankan `docker-prod.bat tunnel`; set true di sini agar selalu menyala.
CLOUDFLARE_QUICK_TUNNEL=false

# ── Keduanya ────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=8h
